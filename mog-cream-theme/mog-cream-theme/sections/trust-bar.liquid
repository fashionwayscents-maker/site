<div class="trust-bar">
  <div class="trust-items">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <span>{{ block.settings.icon }}</span>
        {{ block.settings.text }}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🚚" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free US Shipping $30+" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "🚚", "text": "Free US Shipping $30+" } },
        { "type": "item", "settings": { "icon": "↩️", "text": "60-Day Money Back" } },
        { "type": "item", "settings": { "icon": "⚡", "text": "Ships Next Day" } },
        { "type": "item", "settings": { "icon": "🇺🇸", "text": "Formulated in USA" } },
        { "type": "item", "settings": { "icon": "🧪", "text": "Clinically Tested" } }
      ]
    }
  ]
}
{% endschema %}
