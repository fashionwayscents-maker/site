<section id="benefits" class="section-pad">
  <div class="section-max">
    <div class="section-label">{{ section.settings.label }}</div>
    <h2 class="section-title">{{ section.settings.title | newline_to_br }}</h2>
    <p class="section-body">{{ section.settings.body }}</p>
    <div class="benefits-grid">
      {% for block in section.blocks %}
        <div class="benefit-card" {{ block.shopify_attributes }}>
          <div class="benefit-icon">{{ block.settings.icon }}</div>
          <div class="benefit-title">{{ block.settings.title }}</div>
          <div class="benefit-desc">{{ block.settings.description }}</div>
        </div>
      {% endfor %}
    </div>

    <!-- Before/After Transformations -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:40px;">
      <div style="position:relative;border:1px solid var(--border);border-radius:4px;overflow:hidden;">
        <img src="{{ 'transformation-1.png' | asset_url }}" alt="MOG Cream Before and After — Transformation 1" style="width:100%;display:block;">
        <div style="position:absolute;top:12px;left:12px;background:rgba(8,8,8,0.75);border:1px solid var(--border);padding:5px 12px;border-radius:2px;font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#888;">28 Day Result</div>
      </div>
      <div style="position:relative;border:1px solid var(--border);border-radius:4px;overflow:hidden;">
        <img src="{{ 'transformation-2.png' | asset_url }}" alt="MOG Cream Before and After — Transformation 2" style="width:100%;display:block;">
        <div style="position:absolute;top:12px;left:12px;background:rgba(8,8,8,0.75);border:1px solid var(--border);padding:5px 12px;border-radius:2px;font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#888;">28 Day Result</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "label", "label": "Section Label", "default": "Why MOG Cream" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "FAST-ACTING.\nVISIBLE RESULTS." },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "Non-greasy, lightweight formula absorbs instantly — zero residue, all results." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "💎" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sharper Jawline" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Peptide complex firms and tightens the jawline area for a visibly more defined look." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "💎", "title": "Sharper Jawline", "description": "Peptide complex firms and tightens the jawline area for a visibly more defined, chiseled look." } },
        { "type": "benefit", "settings": { "icon": "💪", "title": "Firmer Skin", "description": "Tripeptide technology visibly firms and tightens skin elasticity around the neck and chin." } },
        { "type": "benefit", "settings": { "icon": "💧", "title": "Deep Hydration", "description": "Hyaluronic acid locks in moisture at the deepest layers for all-day hydration without grease." } },
        { "type": "benefit", "settings": { "icon": "⚡", "title": "Fast Absorption", "description": "Non-sticky finish absorbs in seconds. No white cast. No residue. Just results you can feel." } }
      ]
    }
  ]
}
{% endschema %}
