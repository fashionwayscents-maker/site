<section id="order" class="cta-section section-pad">
  <div class="cta-glow"></div>
  <div class="section-max" style="position:relative;z-index:2;text-align:center;">
    <div class="section-label" style="justify-content:center;">{{ section.settings.label }}</div>
    <h2 class="section-title" style="font-size:clamp(52px,7vw,90px);">
      {{ section.settings.title | newline_to_br }}
    </h2>
    <p class="section-body" style="margin:0 auto 20px;">{{ section.settings.body }}</p>
    <div style="display:inline-flex;flex-direction:column;align-items:center;gap:16px;margin-top:40px;">
      <a href="{{ section.settings.cta_url }}" class="btn-primary" style="font-size:18px;padding:20px 56px;">
        {{ section.settings.cta_label }}
      </a>
      <p style="font-size:13px;color:var(--gray);letter-spacing:.06em;">
        🔒 Secure Checkout &nbsp;·&nbsp; Free US Shipping Over $30 &nbsp;·&nbsp; 60-Day Guarantee
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Start Today" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "DEFINED TODAY.\nCONFIDENT EVERYDAY." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "A sharper jawline changes how the world sees you. MOG Cream helps you keep it. Use once daily — results in 28 days or your money back." },
    { "type": "text", "id": "cta_label", "label": "CTA Label", "default": "Get MOG Cream — $23.00" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}
